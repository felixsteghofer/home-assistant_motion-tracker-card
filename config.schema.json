{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/felixsteghofer/home-assistant_motion-tracker-card/config.schema.json",
  "title": "Motion Tracker Card configuration",
  "type": "object",
  "required": [
    "type",
    "floors",
    "sources"
  ],
  "properties": {
    "type": {
      "const": "custom:motion-tracker-card"
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/floor"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "minutes": {
      "type": "number",
      "minimum": 1,
      "maximum": 1440,
      "default": 30
    },
    "fresh_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 5
    },
    "refresh_seconds": {
      "type": "number",
      "minimum": 5,
      "default": 30
    },
    "history_refresh_seconds": {
      "type": "number",
      "minimum": 15,
      "default": 60
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 2
    },
    "stack_below": {
      "type": "number",
      "minimum": 240,
      "maximum": 1600,
      "default": 640
    },
    "time_zone": {
      "type": [
        "string",
        "null"
      ]
    },
    "history_entity": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "history": {
      "type": "boolean"
    },
    "show_legend": {
      "type": "boolean"
    },
    "show_count": {
      "type": "boolean"
    },
    "show_details": {
      "type": "boolean"
    },
    "show_status": {
      "type": "boolean"
    },
    "show_furniture": {
      "type": "boolean"
    },
    "show_windows": {
      "type": "boolean"
    },
    "show_untracked": {
      "type": "boolean"
    },
    "colors": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "room": {
          "type": "string"
        },
        "untracked": {
          "type": "string"
        },
        "wall": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "muted": {
          "type": "string"
        },
        "latest": {
          "type": "string"
        },
        "fresh": {
          "type": "string"
        },
        "recent": {
          "type": "string"
        },
        "selected": {
          "type": "string"
        },
        "status_background": {
          "type": "string"
        },
        "status_text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "properties": {
        "latest": {
          "type": "string"
        },
        "fresh": {
          "type": "string"
        },
        "recent": {
          "type": "string"
        },
        "untracked": {
          "type": "string"
        },
        "quiet": {
          "type": "string"
        },
        "loading": {
          "type": "string"
        },
        "history_error": {
          "type": "string"
        },
        "history_button": {
          "type": "string"
        },
        "now": {
          "type": "string"
        },
        "minutes_ago": {
          "type": "string"
        },
        "hours_ago": {
          "type": "string"
        },
        "room_count": {
          "type": "string"
        },
        "no_events": {
          "type": "string"
        },
        "no_detail": {
          "type": "string"
        },
        "no_channel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "properties": {
        "room_font_size": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "status_font_size": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "wall_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "outline_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "status_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "status_height": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "furniture_color": {
          "type": "string"
        },
        "furniture_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "floor_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "shape": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "path",
            "rect",
            "circle",
            "ellipse",
            "line",
            "polyline",
            "polygon"
          ]
        },
        "d": {
          "type": "string"
        },
        "points": {
          "type": "string"
        },
        "fill": {
          "type": "string"
        },
        "stroke": {
          "type": "string"
        },
        "stroke-linecap": {
          "type": "string"
        },
        "stroke-linejoin": {
          "type": "string"
        },
        "stroke-dasharray": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        },
        "x": {
          "type": [
            "number",
            "string"
          ]
        },
        "y": {
          "type": [
            "number",
            "string"
          ]
        },
        "width": {
          "type": [
            "number",
            "string"
          ]
        },
        "height": {
          "type": [
            "number",
            "string"
          ]
        },
        "rx": {
          "type": [
            "number",
            "string"
          ]
        },
        "ry": {
          "type": [
            "number",
            "string"
          ]
        },
        "cx": {
          "type": [
            "number",
            "string"
          ]
        },
        "cy": {
          "type": [
            "number",
            "string"
          ]
        },
        "r": {
          "type": [
            "number",
            "string"
          ]
        },
        "x1": {
          "type": [
            "number",
            "string"
          ]
        },
        "y1": {
          "type": [
            "number",
            "string"
          ]
        },
        "x2": {
          "type": [
            "number",
            "string"
          ]
        },
        "y2": {
          "type": [
            "number",
            "string"
          ]
        },
        "opacity": {
          "type": [
            "number",
            "string"
          ]
        },
        "stroke-width": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "label_position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "status_position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "untracked": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text",
              "position"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "additionalProperties": false
          }
        },
        "status_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "status_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        },
        "status_font_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 500
        }
      },
      "anyOf": [
        {
          "required": [
            "label_position"
          ]
        },
        {
          "required": [
            "labels"
          ]
        }
      ],
      "additionalProperties": false
    },
    "floor": {
      "type": "object",
      "required": [
        "id",
        "view_box",
        "rooms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "view_box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "outline": {
          "type": "string"
        },
        "rooms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/room"
          }
        },
        "furniture": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "decorations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape"
          }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "entity"
      ],
      "properties": {
        "entity": {
          "type": "string"
        },
        "type": {
          "enum": [
            "binary",
            "timestamp",
            "event"
          ]
        },
        "room": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "number",
          "default": 0
        },
        "room_pattern": {
          "type": "string"
        },
        "room_group": {
          "type": "integer",
          "minimum": 1
        },
        "room_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "detail_pattern": {
          "type": "string"
        },
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "event"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "room_pattern",
              "room_map"
            ]
          },
          "else": {
            "required": [
              "room"
            ]
          }
        }
      ]
    },
    "timestamp": {
      "type": "object",
      "properties": {
        "from": {
          "enum": [
            "state",
            "last_changed",
            "last_updated",
            "attribute"
          ]
        },
        "format": {
          "enum": [
            "iso",
            "local"
          ]
        },
        "attribute": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "time_zone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}